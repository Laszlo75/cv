  shorttitle = {Donors {{With Previous Malignancy}}},
  author = {Turra, Vitor and Manzi, Joao and Rombach, Sarah and Zaragoza, Simone and Ferreira, Raphaella and Guerra, Giselle and Conzen, Kendra and Nydam, Trevor and Livingstone, Alan and Vianna, Rodrigo and Abreu, Phillipe},
  date = {2025-01-24},
  journaltitle = {Transplant International},
  shortjournal = {Transpl Int},
