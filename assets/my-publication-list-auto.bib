  author = {Koukounas, Kalli G. and Thorsness, Rebecca and Patzer, Rachel E. and Wilk, Adam S. and Drewry, Kelsey M. and Mehrotra, Rajnish and Rivera-Hernandez, Maricruz and Meyers, David J. and Kim, Daeho and Trivedi, Amal N.},
  date = {2024-01-09},
  journaltitle = {JAMA},
