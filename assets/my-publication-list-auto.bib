@article{shiObesityAssociatedDelayed2023,
  title = {Obesity Is {{Associated With Delayed Graft Function}} in {{Kidney Transplant Recipients}}: {{A Paired Kidney Analysis}}},
  shorttitle = {Obesity Is {{Associated With Delayed Graft Function}} in {{Kidney Transplant Recipients}}},
  author = {Shi, Bree and Ying, Tracey and Xu, Josephine and Wyburn, Kate and Laurence, Jerome and Chadban, Steven J},
  date = {2023-05-30},
  journaltitle = {Transplant International},
  shortjournal = {Transpl Int},
  volume = {36},
  pages = {11107},
  issn = {1432-2277},
  doi = {10.3389/ti.2023.11107},
  url = {https://www.frontierspartnerships.org/articles/10.3389/ti.2023.11107/full},
  urldate = {2023-09-15},
  abstract = {Obesity is increasingly prevalent among candidates for kidney transplantation. Existing studies have shown conflicting post-transplant outcomes for obese patients which may relate to confounding bias from donor-related characteristics that were unaccounted for. We used ANZDATA Registry data to compare graft and patient survival between obese (BMI {$>$}27.5 kg/m2 Asians; {$>$}30 kg/m2 non-Asians) and non-obese kidney transplant recipients, while controlling for donor characteristics by comparing recipients of paired kidneys. We selected transplant pairs (2000–2020) where a deceased donor supplied one kidney to an obese candidate and the other to a non-obese candidate. We compared the incidence of delayed graft function (DGF), graft failure and death by multivariable models. We identified 1,522 pairs. Obesity was associated with an increased risk of DGF (aRR = 1.26, 95\% CI 1.11–1.44, p {$<$} 0.001). Obese recipients were more likely to experience death-censored graft failure (aHR = 1.25, 95\% CI 1.05–1.49, p = 0.012), and more likely to die with function (aHR = 1.32, 95\% CI 1.15–1.56, p = 0.001), versus non-obese recipients. Long-term patient survival was significantly worse in obese patients with 10- and 15-year survival of 71\% and 56\% compared to 77\% and 63\% in non-obese patients. Addressing obesity is an unmet clinical need in kidney transplantation.},
  langid = {english},
  file = {/Users/laszlo/Zotero/storage/BTV2IW9D/Shi et al. - 2023 - Obesity is Associated With Delayed Graft Function .pdf}
}

@article{singhImpactDonorRecipient2020,
