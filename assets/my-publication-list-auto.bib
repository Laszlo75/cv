@article{fallaniRenalVesselExtension2023,
  title = {Renal {{Vessel Extension With Cryopreserved Vascular Grafts}}: {{Overcoming Surgical Pitfalls}} in {{Living Donor Kidney Transplant}}},
  shorttitle = {Renal {{Vessel Extension With Cryopreserved Vascular Grafts}}},
  author = {Fallani, Guido and Maroni, Lorenzo and Bonatti, Chiara and Comai, Giorgia and Buzzi, Marina and Cuna, Vania and Vasuri, Francesco and Caputo, Francesca and Prosperi, Enrico and Pisani, Federico and Pisillo, Beatrice and Maurino, Ludovica and Odaldi, Federica and Bertuzzo, Valentina Rosa and Tondolo, Francesco and Busutti, Marco and Zanfi, Chiara and Del Gaudio, Massimo and La Manna, Gaetano and Ravaioli, Matteo},
  date = {2023-02-10},
  journaltitle = {Transplant International},
