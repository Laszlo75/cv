  author = {Loupy, Alexandre and Haas, Mark and Roufosse, Candice and Naesens, Maarten and Adam, Benjamin and Afrouzian, Marjan and Akalin, Enver and Alachkar, Nada and Bagnasco, Serena and Becker, Jan U. and Cornell, Lynn D. and Clahsen‐van Groningen, Marian C. and Demetris, Anthony J. and Dragun, Duska and Duong van Huyen, Jean‐Paul and Farris, Alton B. and Fogo, Agnes B. and Gibson, Ian W. and Glotz, Denis and Gueguen, Juliette and Kikic, Zeljko and Kozakowski, Nicolas and Kraus, Edward and Lefaucheur, Carmen and Liapis, Helen and Mannon, Roslyn B. and Montgomery, Robert A. and Nankivell, Brian J. and Nickeleit, Volker and Nickerson, Peter and Rabant, Marion and Racusen, Lorraine and Randhawa, Parmjeet and Robin, Blaise and Rosales, Ivy A. and Sapir‐Pichhadze, Ruth and Schinstock, Carrie A. and Seron, Daniel and Singh, Harsharan K. and Smith, Rex N. and Stegall, Mark D. and Zeevi, Adriana and Solez, Kim and Colvin, Robert B. and Mengel, Michael},
  date = {2020-09},
  journaltitle = {American Journal of Transplantation},
  shortjournal = {Am J Transplant},
  volume = {20},
  number = {9},
  eprint = {32463180},
  eprinttype = {pubmed},
  pages = {2318--2331},
  issn = {1600-6135},
  doi = {10.1111/ajt.15898},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7496245/},
  urldate = {2025-09-02},
  abstract = {The XV. Banff conference for allograft pathology was held in conjunction with the annual meeting of the American Society for Histocompatibility and Immunogenetics in Pittsburgh, PA (USA) and focused on refining recent updates to the classification, advances from the Banff working groups, and standardization of molecular diagnostics. This report on kidney transplant pathology details clarifications and refinements to the criteria for chronic active (CA) T cell–mediated rejection (TCMR), borderline, and antibody‐mediated rejection (ABMR). The main focus of kidney sessions was on how to address biopsies meeting criteria for CA TCMR plus borderline or acute TCMR. Recent studies on the clinical impact of borderline infiltrates were also presented to clarify whether the threshold for interstitial inflammation in diagnosis of borderline should be i0 or i1. Sessions on ABMR focused on biopsies showing microvascular inflammation in the absence of C4d staining or detectable donor‐specific antibodies; the potential value of molecular diagnostics in such cases and recommendations for use of the latter in the setting of solid organ transplantation are presented in the accompanying meeting report. Finally, several speakers discussed the capabilities of artificial intelligence and the potential for use of machine learning algorithms in diagnosis and personalized therapeutics in solid organ transplantation., This report focuses on the clarification of the criteria for chronic active T cell–mediated rejection and antibody‐mediated rejection and the optimization of the inflammation threshold for the diagnosis of borderline for acute T cell–mediated rejection, and discusses the potential to use machine learning in diagnostics and personalized therapeutics in solid organ transplantation.},
