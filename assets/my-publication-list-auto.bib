@article{mamodeEuropeanGuidelineManagement2022,
  title = {European {{Guideline}} for the {{Management}} of {{Kidney Transplant Patients With HLA Antibodies}}: {{By}} the {{European Society}} for {{Organ Transplantation Working Group}}},
  shorttitle = {European {{Guideline}} for the {{Management}} of {{Kidney Transplant Patients With HLA Antibodies}}},
  author = {Mamode, Nizam and Bestard, Oriol and Claas, Frans and Furian, Lucrezia and Griffin, Siân and Legendre, Christophe and Pengel, Liset and Naesens, Maarten},
  date = {2022-08-10},
  journaltitle = {Transplant International},
  shortjournal = {Transpl Int},
  volume = {35},
  pages = {10511},
  issn = {1432-2277},
  doi = {10.3389/ti.2022.10511},
  url = {https://www.frontierspartnerships.org/articles/10.3389/ti.2022.10511/full},
  urldate = {2023-11-08},
  abstract = {This guideline, from a European Society of Organ Transplantation (ESOT) working group, concerns the management of kidney transplant patients with HLA antibodies. Sensitization should be defined using a virtual parameter such as calculated Reaction Frequency (cRF), which assesses HLA antibodies derived from the actual organ donor population. Highly sensitized patients should be prioritized in kidney allocation schemes and linking allocation schemes may increase opportunities. The use of the ENGAGE 5               (               (Bestard et al., Transpl Int, 2021, 34: 1005–1018) system and online calculators for assessing risk is recommended. The Eurotransplant Acceptable Mismatch program should be extended. If strategies for finding a compatible kidney are very unlikely to yield a transplant, desensitization may be considered and should be performed with plasma exchange or immunoadsorption, supplemented with IViG and/or anti-CD20 antibody. Newer therapies, such as imlifidase, may offer alternatives. Few studies compare HLA incompatible transplantation with remaining on the waiting list, and comparisons of morbidity or quality of life do not exist. Kidney paired exchange programs (KEP) should be more widely used and should include unspecified and deceased donors, as well as compatible living donor pairs. The use of a KEP is preferred to desensitization, but highly sensitized patients should not be left on a KEP list indefinitely if the option of a direct incompatible transplant exists.},
  file = {/Users/laszlo/Zotero/storage/852LUSV3/Mamode et al - 2022 - European Guideline for the Management of Kidney Transplant Patients With HLA.pdf}
}

