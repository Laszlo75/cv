@article{andacogluAddressingBurdenManagement2023,
  title = {Addressing the {{Burden}} and {{Management Strategies}} for {{Disparities}} and {{Inequities Among Liver Transplant Professionals}}: {{The ILTS Experience}}},
  shorttitle = {Addressing the {{Burden}} and {{Management Strategies}} for {{Disparities}} and {{Inequities Among Liver Transplant Professionals}}},
  author = {Andacoglu, Oya and Izzy, Manhal and Adelmann, Dieter and Aguilera, Victoria and Becchetti, Chiara and Berenguer, Marina and Berlakovich, Gabriella A. and Ghosh, Simantika and Giorgakis, Emmanouil and Kemmer, Nyingi and Lunsford, Keri E. and Montasser, Iman F. and Montenovo, Martin I. and Mrzljak, Anna and Pai, Sher-Lu and Scalera, Irene and Selzner, Nazia},
  date = {2023-06-02},
  journaltitle = {Transplant International},
  shortjournal = {Transpl Int},
  volume = {36},
  pages = {11240},
  issn = {1432-2277},
  doi = {10.3389/ti.2023.11240},
  url = {https://www.frontierspartnerships.org/articles/10.3389/ti.2023.11240/full},
  urldate = {2023-09-15},
  abstract = {Medical professional environments are becoming increasingly multicultural, international, and diverse in terms of its specialists. Many transplant professionals face challenges related to gender, sexual orientation or racial background in their work environment or experience inequities involving access to leadership positions, professional promotion, and compensation. These circumstances not infrequently become a major source of workrelated stress and burnout for these disadvantaged, under-represented transplant professionals. In this review, we aim to 1) discuss the current perceptions regarding disparities among liver transplant providers 2) outline the burden and impact of disparities and inequities in the liver transplant workforce 3) propose potential solutions and role of professional societies to mitigate inequities and maximize inclusion within the transplant community.},
