@article{naesensRationaleSurrogateEndpoints2022,
  title = {Rationale for {{Surrogate Endpoints}} and {{Conditional Marketing Authorization}} of {{New Therapies}} for {{Kidney Transplantation}}},
  author = {Naesens, Maarten and Loupy, Alexandre and Hilbrands, Luuk and Oberbauer, Rainer and Bellini, Maria Irene and Glotz, Denis and Grinyó, Josep and Heemann, Uwe and Jochmans, Ina and Pengel, Liset and Reinders, Marlies and Schneeberger, Stefan and Budde, Klemens},
