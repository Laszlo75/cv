@article{bassaganyas2024,
  title = {Accessibility of {{Percutaneous Biopsy}} in {{Retrocolic-Placed Pancreatic Grafts With}} a {{Duodeno-Duodenostomy}}},
  author = {Bassaganyas, Clara and Darnell, Anna and Soler-Perromat, Alexandre and Rafart, Gerard and Ventura-Aguiar, Pedro and Cuatrecasas, Miriam and Ferrer-Fàbrega, Joana and Ayuso, Carmen and García-Criado, Ángeles},
  date = {2024-08-06},
  journaltitle = {Transplant International},
  shortjournal = {Transpl Int},
  volume = {37},
  pages = {12682},
  issn = {1432-2277},
  doi = {10.3389/ti.2024.12682},
  url = {https://www.frontierspartnerships.org/articles/10.3389/ti.2024.12682/full},
  urldate = {2025-06-07},
  abstract = {Duodeno-duodenostomy (DD) has been proposed as a more physiological alternative to conventional duodeno-jejunostomy (DJ) for pancreas transplantation. Accessibility of percutaneous biopsies in these grafts has not yet been assessed. We conducted a retrospective study including all pancreatic percutaneous graft biopsies requested between November 2009 and July 2021. Whenever possible, biopsies were performed under ultrasound (US) guidance or computed tomography (CT) guidance when the US approach failed. Patients were classified into two groups according to surgical technique (DJ and DD). Accessibility, success for histological diagnosis and complications were compared. Biopsy was performed in 93/136 (68.4\%) patients in the DJ group and 116/132 (87.9\%) of the DD group (p = 0.0001). The graft was not accessible for biopsy mainly due to intestinal loop interposition (n = 29 DJ, n = 10 DD). Adequate sample for histological diagnosis was obtained in 86/93 (92.5\%) of the DJ group and 102/116 (87.9\%) of the DD group (p = 0.2777). One minor complication was noted in the DD group. The retrocolic position of the DD pancreatic graft does not limit access to percutaneous biopsy. This is a safe technique with a high histological diagnostic success rate.},
  langid = {english},
  keywords = {pancreas},
  file = {/Users/laszlo/Zotero/storage/YQAXTK46/Bassaganyas et al. - 2024 - Accessibility of Percutaneous Biopsy in Retrocolic-Placed Pancreatic Grafts With a Duodeno-Duodenost.pdf}
}

