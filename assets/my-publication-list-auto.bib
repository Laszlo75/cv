  author = {Couzi, Lionel and Malvezzi, Paolo and Amrouche, Lucile and Anglicheau, Dany and Blancho, Gilles and Caillard, Sophie and Freist, Marine and Guidicelli, Gwenda Line and Kamar, Nassim and Lefaucheur, Carmen and Mariat, Christophe and Koenig, Alice and Noble, Johan and Thaunat, Olivier and Thierry, Antoine and Taupin, Jean-Luc and Bertrand, Dominique},
